{
  "name": "typical-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css:watch": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "serve": "browser-sync start --server --files \"index.html, privacy/index.html, css/output.css, assets/**/*\" --no-notify --no-ui --port 3000",
    "dev": "concurrently -k -n css,web -c cyan,magenta \"pnpm css:watch\" \"pnpm serve\"",
    "build": "tailwindcss -i ./css/input.css -o ./css/output.css --minify"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "concurrently": "^9.1.0"
  }
}
